DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=memica_user
DB_PASSWORD=change_me
DB_NAME=memica

# Authentication
# Generate a unique value with: openssl rand -base64 48

# Secret key used to sign and verify JWT tokens.
JWT_SECRET=change_me_to_a_unique_random_secret_before_starting_the_api
# Define how long JWT tokens remain valid.
JWT_EXPIRES_IN=3d
# Identify the application or service that issues JWT tokens.
JWT_ISSUER=memica-api
# Identify the intended recipient of JWT tokens.
JWT_AUDIENCE=memica-web
# Frontend origin allowed to access the backend through CORS.
WEB_ORIGIN=http://localhost:3001
# Restrict authentication cookies to HTTPS connections.
AUTH_COOKIE_SECURE=false
# Control when authentication cookies are sent with cross-site requests.
# Options: strict, lax, none.
AUTH_COOKIE_SAME_SITE=lax
# Maximum number of login attempts allowed within the throttling window.
AUTH_LOGIN_THROTTLE_LIMIT=5
# Duration of the login throttling window in seconds.
AUTH_LOGIN_THROTTLE_WINDOW_SECONDS=900

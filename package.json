{
  "name": "memica",
  "private": true,
  "packageManager": "yarn@4.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api:dev": "nx serve api",
    "web:dev": "nx dev web",
    "api:db:up": "docker compose --env-file apps/api/.env -f apps/api/docker-compose.yml up -d",
    "api:db:down": "docker compose --env-file apps/api/.env -f apps/api/docker-compose.yml down",
    "api:db:reset": "docker compose --env-file apps/api/.env -f apps/api/docker-compose.yml down -v",
    "api:auth:bootstrap": "tsc --project apps/api/tsconfig.app.json && node dist/apps/api/main.js auth:bootstrap",
    "api:auth:reset-password": "tsc --project apps/api/tsconfig.app.json && node dist/apps/api/main.js auth:reset-password",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nx/eslint": "^20.8.1",
    "@nx/jest": "^20.8.1",
    "@nx/js": "^20.8.1",
    "@nx/nest": "^20.8.1",
    "@nx/next": "^20.8.1",
    "@nx/workspace": "^20.8.1",
    "@swc/core": "^1.11.24",
    "@types/node": "^22.15.30",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "globals": "^16.0.0",
    "next": "15.2.0",
    "nx": "^20.8.1",
    "prettier": "^3.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.3"
  }
}
